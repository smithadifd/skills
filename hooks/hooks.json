{
  "description": "Prints the ledger's session-start brief when a ledger CLI is configured; silent otherwise.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
