{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-plan-card/v1",
  "title": "Ticket plan card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "title", "acceptance_criteria", "steps"],
  "properties": {
    "schema": {"const": "ticket-plan-card/v1"},
    "key": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "diff_statement": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "ticket_status": {"type": "string"},
    "ticket_updated_at": {"type": "string"},
    "pass": {"type": "string", "minLength": 1, "description": "The pass that presented this plan revision; a plan go names it."},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "passes", "review_evidence"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "passes": {"type": "boolean", "default": false},
          "review_evidence": {"type": ["string", "null"]},
          "review_round": {"type": ["integer", "null"], "minimum": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"passes": {"const": true}}},
            "then": {
              "properties": {
                "review_evidence": {"type": "string", "minLength": 1},
                "review_round": {"type": "integer", "minimum": 1}
              },
              "required": ["review_evidence", "review_round"]
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {
            "enum": ["orient", "research", "plan", "build", "review", "outward"]
          },
          "status": {"enum": ["pending", "complete", "skipped"]},
          "skip": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "skipped"}}},
            "then": {"required": ["skip"]}
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "steps": {
            "contains": {
              "properties": {
                "name": {"const": "plan"},
                "status": {"const": "skipped"}
              },
              "required": ["name", "status"]
            }
          }
        }
      },
      "then": {"required": ["diff_statement"]}
    }
  ]
}
